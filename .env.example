# Copy to .env.local, or pull the values from Vercel with `vercel env pull`

# Sanity
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=

# Sent to the browser in draft mode, so use a Viewer token and never one that can write
SANITY_API_READ_TOKEN=

# Optional: overrides the API version in sanity/lib/api.ts
# NEXT_PUBLIC_SANITY_API_VERSION=

# Application
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Set by Vercel when system environment variables are exposed; elsewhere, set it yourself. Search
# engines are told not to index the site unless this is `production`. Read at build time
# NEXT_PUBLIC_VERCEL_ENV=
